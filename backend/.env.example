# Copy to backend/.env
OPENAI_API_KEY=

# Models
IRIS_TRANSCRIBE_MODEL=whisper-1
# Spoken language (ISO-639-1), or "auto" to let the model detect it (unreliable for some accents).
# Default en; normally chosen on the Settings page. Set here, it wins and the page can't change it.
# A code Whisper doesn't know fails at startup.
# IRIS_TRANSCRIBE_LANGUAGE=en
IRIS_VISION_MODEL=gpt-5.5
IRIS_NOTES_MODEL=gpt-5.5
IRIS_DIAGRAM_MODEL=gpt-5.5
IRIS_IMAGE_MODEL=gpt-image-2
# IRIS_IMAGE_QUALITY=high
# IRIS_REASONING_EFFORT=medium
# IRIS_RENDER_ATTEMPTS=2
# IRIS_RENDER_CONCURRENCY=4

# Delays (seconds) before Iris retries a unit of work after a temporary API error, on top of the
# SDK's own short retries. Figures are not retried: they use the source crop.
# IRIS_API_RETRY_DELAYS_S=[15, 60, 120]

# IRIS_DATA_DIR=data
# IRIS_FRAME_FPS=1.0
# Frames are scaled down to at most this width (pixels): enough to read slides, fewer image tokens
# IRIS_FRAME_MAX_WIDTH=1280
# Audio is resampled to this rate (Hz) before transcription, 8000 to 16000; the speech models
# work at 16 kHz, and a higher rate makes a long chunk too big to upload
# IRIS_AUDIO_SAMPLE_RATE=16000
# Moments per screen-reading call (each sends its frame)
# IRIS_SELECTION_BATCH_SIZE=6
# Evidence characters per notes call (plus the prompt)
# IRIS_NOTES_CONTEXT_CHARS=24000

# Final synthesis across the whole notes (false: the assembled notes are final)
# IRIS_SYNTHESIS=true
# IRIS_SYNTHESIS_MODEL=gpt-5.5
# The planning call runs on every long session, so it thinks lightly
# IRIS_SYNTHESIS_PLAN_REASONING_EFFORT=low
# Section rewrites; unset uses IRIS_NOTES_REASONING_EFFORT
# IRIS_SYNTHESIS_REASONING_EFFORT=

# Live processing while recording (false: process after stop, like an upload)
# IRIS_LIVE_PROCESSING=true
# Seconds to wait for a missing audio chunk before skipping it
# IRIS_LIVE_AUDIO_GAP_WAIT_S=35
# Transcription windows are cut at the quietest point between these lengths (seconds)
# IRIS_LIVE_WINDOW_MIN_S=5
# IRIS_LIVE_WINDOW_MAX_S=15
# IRIS_LIVE_TRANSCRIBE_CONCURRENCY=2
# Seconds frames wait so they can be handled in time order
# IRIS_LIVE_FRAME_HOLDBACK_S=2
# Seconds of transcript past a moment before its screen is read
# IRIS_LIVE_SPEECH_PAD_S=5
# IRIS_LIVE_RENDER_CONCURRENCY=2
# Seconds live work may still run once notes are asked for; a lane still running then is dropped
# and its stages run in full
# IRIS_LIVE_FINISH_TIMEOUT_S=300

# Cost controls: reasoning effort per call type (low, medium, high); unset uses IRIS_REASONING_EFFORT
# (cached screen-reading batches and notes sections are reused whatever the effort)
# IRIS_SELECT_REASONING_EFFORT=
# IRIS_NOTES_REASONING_EFFORT=
# IRIS_DIAGRAM_REASONING_EFFORT=
# IRIS_CHECK_REASONING_EFFORT=
# Model prices in USD (per 1M tokens; audio_per_second for whisper). A price left out is unknown:
# calls that need it show as unpriced, never guessed. Entries add to or replace
# the defaults in config.py, e.g. {"my-model": {"input": 1.0, "cached_input": 0.1, "output": 4.0}}
# IRIS_MODEL_PRICES=

# Browser origins allowed to call the API (default: the Vite dev server of `make dev`)
# IRIS_CORS_ORIGINS=["http://localhost:5173"]

# For running the server by hand; leave unset otherwise. IRIS_API_TOKEN: every request must carry
# it in X-Iris-Token (the desktop app passes its token on stdin instead, with
# --secrets-from-stdin). IRIS_PARENT_PID: the server stops once that process is gone (set by the
# desktop app).
# IRIS_API_TOKEN=
# IRIS_PARENT_PID=
# IRIS_PARENT_POLL_S=1.0
