# Copy to backend/.env
OPENAI_API_KEY=

# Models
IRIS_TRANSCRIBE_MODEL=whisper-1
IRIS_VISION_MODEL=gpt-5.5
IRIS_NOTES_MODEL=gpt-5.5
IRIS_DIAGRAM_MODEL=gpt-5.5
IRIS_IMAGE_MODEL=gpt-image-2
# IRIS_IMAGE_QUALITY=high
# IRIS_REASONING_EFFORT=medium
# IRIS_RENDER_ATTEMPTS=2
# IRIS_RENDER_CONCURRENCY=4

# IRIS_DATA_DIR=data
# IRIS_FRAME_FPS=1.0
# IRIS_SELECTION_BATCH_SIZE=6
# IRIS_NOTES_CONTEXT_CHARS=24000

# Cost controls: reasoning effort per call type (low, medium, high); unset uses IRIS_REASONING_EFFORT
# IRIS_SELECT_REASONING_EFFORT=
# IRIS_NOTES_REASONING_EFFORT=
# IRIS_DIAGRAM_REASONING_EFFORT=
# IRIS_CHECK_REASONING_EFFORT=
# Model prices in USD (per 1M tokens; audio_per_second for whisper). Entries add to or replace
# the defaults in config.py, e.g. {"my-model": {"input": 1.0, "cached_input": 0.1, "output": 4.0}}
# IRIS_MODEL_PRICES=
