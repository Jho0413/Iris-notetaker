{
  "name": "iris-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Spike: Electron shell around the Iris UI and backend",
  "main": "main.cjs",
  "scripts": {
    "start": "open -n -W node_modules/electron/dist/Electron.app --args \"$PWD\"",
    "probe": "open -n -W node_modules/electron/dist/Electron.app --args \"$PWD\" --probe; cat \"$TMPDIR/iris-desktop.log\""
  },
  "devDependencies": {
    "electron": "^45.2.2"
  }
}
