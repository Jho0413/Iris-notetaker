<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Iris.app itself, signed with the hardened runtime: only what it needs is let back in. -->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript to machine code as it runs. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- The app is ad-hoc signed, so neither it nor its frameworks have a Team ID, and library
         validation would refuse to load Electron's own framework. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The microphone, for recordings. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
